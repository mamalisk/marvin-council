# Copy to .env.local. Never commit real credentials.
AUTH_MODE=github
# Exact external origin. Production requires HTTPS.
APP_ORIGIN=http://127.0.0.1:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated user/organization logins or enterprise slugs. At least one list must be nonempty.
# Access is granted by any list; enterprise access requires a successful GitHub GraphQL membership check.
GITHUB_ALLOWED_ORGS=
GITHUB_ALLOWED_USERS=
GITHUB_ALLOWED_ENTERPRISES=
# Generate independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
# Use a dedicated database and verify TLS certificates for remote connections.
DATABASE_URL=postgresql://marvin:replace-me@127.0.0.1:5432/marvin
